<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Quản lý ca làm & Debug JavaScript</title>

    <!-- Bootstrap -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
  </head>

  <body style="background-color: white; color: black">
    <div class="container mt-5">
      <!-- Tiêu đề -->
      <h2 class="text-center mb-4">Quản lý ca làm</h2>

      <!-- Nút đổi giao diện -->
      <div class="text-center mb-4">
        <button class="btn btn-dark" onclick="changeTheme()">
          Đổi giao diện
        </button>
      </div>

      <!-- FORM -->
      <form id="workForm" class="shadow p-4 rounded bg-light">
        <div class="mb-3">
          <label class="form-label">Tên công việc</label>

          <input type="text" id="jobName" class="form-control" required />
        </div>

        <div class="mb-3">
          <label class="form-label">Số giờ làm</label>

          <input type="number" id="hours" class="form-control" required />
        </div>

        <div class="mb-3">
          <label class="form-label">Đơn giá / giờ</label>

          <input type="number" id="salary" class="form-control" required />
        </div>

        <div class="mb-3">
          <label class="form-label">Mã số sinh viên</label>

          <input type="text" id="studentId" class="form-control" required />
        </div>

        <button class="btn btn-primary w-100">Thêm công việc</button>
      </form>

      <!-- BẢNG -->
      <table class="table table-bordered table-striped mt-5 text-center">
        <thead class="table-dark">
          <tr>
            <th>Tên công việc</th>
            <th>Số giờ</th>
            <th>Đơn giá</th>
            <th>Thu nhập</th>
          </tr>
        </thead>

        <tbody id="tableBody"></tbody>

        <tfoot>
          <tr>
            <th colspan="3">Tổng thu nhập</th>
            <th id="totalIncome">0</th>
          </tr>
        </tfoot>
      </table>

      <!-- Cảnh báo -->
      <div id="warning" class="alert alert-danger d-none">
        Chú ý sức khỏe và việc học
      </div>

      <!-- PHẦN DEBUG -->
      <div class="mt-5">
        <h3 class="mb-3">Debug JavaScript</h3>

        <h5>Code đã sửa lỗi</h5>

        <pre class="bg-success text-white p-3 rounded">
const changeTheme = () => {
    let body = document.querySelector("body");

    if (body.style.backgroundColor === "white") {
        body.style.backgroundColor = "black";
        body.style.color = "white";
    }
    else {
        body.style.backgroundColor = "white";
        body.style.color = "black";
    }
}
            </pre
        >

        <h5 class="mt-4">Giải thích lỗi</h5>

        <ul class="list-group">
          <li class="list-group-item">
            Dùng <strong>backgroundColor</strong>
            thay vì background
          </li>

          <li class="list-group-item">
            Dùng <strong>===</strong>
            để so sánh chính xác
          </li>

          <li class="list-group-item">Bổ sung đầy đủ dấu ;</li>

          <li class="list-group-item">Thêm nút gọi hàm changeTheme()</li>
        </ul>
      </div>
    </div>

    <!-- JAVASCRIPT -->
    <script>
      // =========================
      // ĐỔI GIAO DIỆN
      // =========================

      const changeTheme = () => {
        let body = document.querySelector("body");

        if (body.style.backgroundColor === "white") {
          body.style.backgroundColor = "black";
          body.style.color = "white";
        } else {
          body.style.backgroundColor = "white";
          body.style.color = "black";
        }
      };

      // =========================
      // QUẢN LÝ CA LÀM
      // =========================

      const form = document.getElementById("workForm");

      const tableBody = document.getElementById("tableBody");

      const totalIncome = document.getElementById("totalIncome");

      const warning = document.getElementById("warning");

      let total = 0;

      let totalHours = 0;

      form.addEventListener("submit", function (e) {
        e.preventDefault();

        // Lấy dữ liệu
        const jobName = document.getElementById("jobName").value;

        const hours = Number(document.getElementById("hours").value);

        const salary = Number(document.getElementById("salary").value);

        const studentId = document.getElementById("studentId").value;

        // Tính thu nhập
        const income = hours * salary;

        // Cộng tổng
        total += income;

        totalHours += hours;

        // Tạo dòng mới
        const row = document.createElement("tr");

        row.innerHTML = `
                <td>${jobName}</td>
                <td>${hours}</td>
                <td>${salary}</td>
                <td>${income}</td>
            `;

        // Lấy số cuối MSSV
        const lastNumber = Number(studentId[studentId.length - 1]);

        // Nếu lẻ -> thêm đầu bảng
        if (lastNumber % 2 !== 0) {
          tableBody.prepend(row);
        }

        // Nếu chẵn -> thêm cuối bảng
        else {
          tableBody.appendChild(row);
        }

        // Hiển thị tổng thu nhập
        totalIncome.innerText = total;

        // Cảnh báo nếu quá 20 giờ
        if (totalHours > 20) {
          warning.classList.remove("d-none");
        }

        // Reset form
        form.reset();
      });
    </script>
  </body>
</html>
